generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum ShipmentStatus {
  DRAFT
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum ShipmentType {
  EXPRESS
  STANDARD
  ECONOMY
  FREIGHT
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
}

enum EventType {
  PICKED_UP
  DEPARTED
  ARRIVED
  CUSTOMS_HOLD
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}

enum DocumentTypeEnum {
  POD
  CUSTOMS
  INVOICE
  MANIFEST
  OTHER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdShipments Shipment[]
  createdCustomers Customer[]
  recordedEvents  ShipmentEvent[]
  uploadedDocs    Document[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  company     String?  @db.VarChar(255)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  address     Json?
  taxId       String?  @map("tax_id") @db.VarChar(100)
  creditLimit Decimal? @map("credit_limit") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator      User?       @relation(fields: [createdBy], references: [id])
  shipments    Shipment[]
  invoices     Invoice[]

  @@map("customers")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(20)
  address   Json
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  capacity  Int?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  originShipments Shipment[] @relation("OriginWarehouse")
  destShipments   Shipment[] @relation("DestWarehouse")

  @@map("warehouses")
}

model Carrier {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  code       String   @unique @db.VarChar(20)
  apiEndpoint String? @map("api_endpoint") @db.VarChar(500)
  isActive   Boolean  @default(true) @map("is_active")

  shipments Shipment[]

  @@map("carriers")
}

model Shipment {
  id                 String          @id @default(uuid()) @db.Uuid
  trackingNumber     String          @unique @map("tracking_number") @db.VarChar(50)
  status             ShipmentStatus  @default(DRAFT)
  type               ShipmentType
  customerId         String          @map("customer_id") @db.Uuid
  carrierId          String?         @map("carrier_id") @db.Uuid
  originWarehouseId  String?         @map("origin_warehouse_id") @db.Uuid
  destWarehouseId    String?         @map("dest_warehouse_id") @db.Uuid
  originAddress      Json            @map("origin_address")
  destAddress        Json            @map("dest_address")
  estimatedDelivery  DateTime?       @map("estimated_delivery")
  actualDelivery     DateTime?       @map("actual_delivery")
  weight             Decimal?        @db.Decimal(10, 3)
  dimensions         Json?
  specialInstructions String?        @map("special_instructions") @db.Text
  createdBy          String?         @map("created_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  customer         Customer    @relation(fields: [customerId], references: [id])
  carrier          Carrier?    @relation(fields: [carrierId], references: [id])
  originWarehouse  Warehouse?  @relation("OriginWarehouse", fields: [originWarehouseId], references: [id])
  destWarehouse    Warehouse?  @relation("DestWarehouse", fields: [destWarehouseId], references: [id])
  creator          User?       @relation(fields: [createdBy], references: [id])
  items            ShipmentItem[]
  events           ShipmentEvent[]
  documents        Document[]
  invoiceLines     InvoiceLine[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt, estimatedDelivery])
  @@map("shipments")
}

model ShipmentItem {
  id          String  @id @default(uuid()) @db.Uuid
  shipmentId  String  @map("shipment_id") @db.Uuid
  description String  @db.VarChar(500)
  quantity    Int
  unitValue   Decimal? @map("unit_value") @db.Decimal(12, 2)
  hsCode      String?  @map("hs_code") @db.VarChar(20)
  weight      Decimal? @db.Decimal(10, 3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("shipment_items")
}

model ShipmentEvent {
  id          String    @id @default(uuid()) @db.Uuid
  shipmentId  String    @map("shipment_id") @db.Uuid
  eventType   EventType @map("event_type")
  location    String?   @db.VarChar(255)
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  notes       String?   @db.Text
  recordedBy  String?   @map("recorded_by") @db.Uuid
  recordedAt  DateTime  @default(now()) @map("recorded_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  recorder User?    @relation(fields: [recordedBy], references: [id])

  @@index([shipmentId, recordedAt])
  @@map("shipment_events")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(30)
  customerId    String        @map("customer_id") @db.Uuid
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  dueDate       DateTime      @map("due_date") @db.Date
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer Customer      @relation(fields: [customerId], references: [id])
  lines    InvoiceLine[]

  @@index([customerId, status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  shipmentId  String? @map("shipment_id") @db.Uuid
  description String  @db.VarChar(500)
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  @@map("invoice_lines")
}

model Document {
  id         String         @id @default(uuid()) @db.Uuid
  shipmentId String?        @map("shipment_id") @db.Uuid
  type       DocumentTypeEnum
  fileName   String         @map("file_name") @db.VarChar(255)
  fileUrl    String         @map("file_url") @db.VarChar(1000)
  uploadedBy String?        @map("uploaded_by") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  shipment Shipment? @relation(fields: [shipmentId], references: [id])
  uploader User?     @relation(fields: [uploadedBy], references: [id])

  @@map("documents")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.Uuid
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}
