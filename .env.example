# Database
DATABASE_URL=postgresql://bm_user:bm_password@localhost:5432/bm_logistics

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bm-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# App
API_PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
